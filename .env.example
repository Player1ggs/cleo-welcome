# Discord Bot Token (NEVER share this!)
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE

# Channel IDs (Right-click channel → Copy Channel ID)
WELCOME_CHANNEL_ID=1234567890123456789
GOODBYE_CHANNEL_ID=1234567890123456789

# Optional: Auto-assign role ID when someone joins
AUTO_ROLE_ID=

# Optional: Send DM welcome message (true/false)
SEND_DM_WELCOME=true

# Render port
PORT=3000